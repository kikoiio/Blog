# Absolute path to your separate private archive (blogs/ and pictures/).
# Leave empty to run Folio without personal files.
FOLIO_ARCHIVE_PATH=
FOLIO_SITE_TITLE=Folio

# Publishing (source files remain in private R2, not GitHub).
FOLIO_WEBSITE_REPOSITORY=your-user/Folio
FOLIO_SOURCE_BUCKET=folio-originals
FOLIO_MEDIA_BUCKET=folio-media
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
FOLIO_SITE_URL=
# Optional: use CLOUDFLARE_API_TOKEN instead of local Wrangler OAuth.
